    "import numpy as np\n",
    "\n",
    "X = np.array([30, 50, 80])\n",
    "y = np.array([50, 110, 140])\n",
    "y_pred = np.array([52.5, 87.5, 140.0])\n",
    "\n",
    "e = y - y_pred\n",
    "\n",
    "print(np.dot(X, e))\n",
    "\n",
    "# X = np.array([[30], [50], [80]])\n",
    "\n",
    "print(X.T @ X)"
   ]
