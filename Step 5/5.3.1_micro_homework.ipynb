   "source": [
    "import numpy as np\n",
    "\n",
    "X_raw = np.array([\n",
    "    [40, 5],\n",
    "    [70, 15],\n",
    "    [100, 2],\n",
    "])\n",
    "\n",
    "ones = np.ones((3, 1))\n",
    "X_full = np.hstack((ones, X_raw))\n",
    "print(X_full)\n",
    "w = np.array([[1000], [150], [-100]])\n",
    "\n",
    "y_pred = X_full @ w\n",
    "print(y_pred)"
   ]
  }
