    "import numpy as np\n",
    "\n",
    "def predict_price(X, w, b):\n",
    "    return np.array(X) * w + b\n",
    "\n",
    "X = [33, 45, 65, 100]\n",
    "prices = predict_price(X, w=150, b=2000)\n",
    "print(prices)\n",
    "# Вывод: [ 6950  8750 11750 17000]"
   ]
  }
